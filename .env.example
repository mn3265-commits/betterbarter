# Copy to `.env` for local dev, and set the same two vars in Vercel
# (Project → Settings → Environment Variables). Both are safe to expose to the
# browser: the anon key only grants what row-level security allows.
#
# Find them in Supabase → Project Settings → API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
